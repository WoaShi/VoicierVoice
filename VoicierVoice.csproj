<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VoicierVoice</AssemblyName>
    <RootNamespace>VoiceLockStudio</RootNamespace>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <ApplicationIcon>Assets\Icons\VoicierVoice.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <Product>VoicierVoice</Product>
    <UseGpuOnnxRuntime Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64'">true</UseGpuOnnxRuntime>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.17.1" Condition="'$(UseGpuOnnxRuntime)' == 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" Condition="'$(UseGpuOnnxRuntime)' != 'true'" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Models\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\Images\HomeHero.jpg" />
    <Resource Include="Assets\Icons\VoicierVoice.ico" />
    <Resource Include="Assets\Icons\VoicierVoice.png" />
    <Resource Include="Assets\Icons\VoicierVoice-bw.ico" />
    <Resource Include="Assets\Icons\VoicierVoice-bw.png" />
  </ItemGroup>

</Project>
