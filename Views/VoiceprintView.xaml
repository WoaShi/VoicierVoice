<UserControl x:Class="VoiceLockStudio.Views.VoiceprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoiceLockStudio.Controls"
             xmlns:loc="clr-namespace:VoiceLockStudio.Services.Localization">
    <StackPanel>

        <!-- Reading Prompt Card -->
        <Border Style="{StaticResource GalleryCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoiceprintPromptLabel}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding PromptReadText}"
                           FontSize="16"
                           FontWeight="Normal"
                           LineHeight="26"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Capture & Verification Card with Animated Guidance Border -->
        <Grid x:Name="VoiceprintCaptureHost">
            <Border Style="{StaticResource GalleryCardStyle}">
                <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE720;"
                                   FontSize="15"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoiceprintCardTitle}"
                                   Style="{StaticResource GallerySectionTitleTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoiceprintCardHint}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource VoiceprintStatusIconBadgeStyle}"
                                        ToolTip="{Binding VoiceprintStatusText}"
                                        VerticalAlignment="Center" />

                        <Button Style="{StaticResource SubtleActionButtonStyle}"
                                Width="30"
                                Height="28"
                                Padding="0"
                                Margin="6,0,0,0"
                                Command="{Binding OpenVoiceprintFolderCommand}"
                                ToolTip="{Binding Source={x:Static loc:AppStrings.Current}, Path=OpenVoiceprintFolderTooltip}"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE838;"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{DynamicResource AccentButtonStyle}"
                            Command="{Binding RecordVoiceprintCommand}"
                            Padding="14,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE720;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Source={x:Static loc:AppStrings.Current}, Path=RecordVoiceprintButton}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="{Binding Source={x:Static loc:AppStrings.Current}, Path=StopRecordingButton}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding PlaySampleCommand}"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlayingSample}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Source={x:Static loc:AppStrings.Current}, Path=PlaySampleButton}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlayingSample}" Value="True">
                                                <Setter Property="Text" Value="{Binding Source={x:Static loc:AppStrings.Current}, Path=StopPlaybackButton}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding RebuildCacheCommand}"
                            Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=RebuildCacheButton}"
                            Padding="12,7"
                            ToolTip="{Binding Source={x:Static loc:AppStrings.Current}, Path=RebuildCacheTooltip}" />

                    <TextBlock Grid.Column="3"
                               Text="{Binding RecordingStatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0" />
                </Grid>

                <!-- Progress & Live Mic Level -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=RecordingProgressLabel}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,5" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding RecordingProgress, Mode=OneWay}"
                                     Height="5" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=RecordingMicLevelLabel}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,5" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding RecordingLevel, Mode=OneWay}"
                                     Height="5" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,0,0,10" />

                <TextBlock Text="{Binding VoiceprintDetailText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <Border x:Name="VoiceprintGuideOverlay"
                CornerRadius="8"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>

    </StackPanel>
</UserControl>
