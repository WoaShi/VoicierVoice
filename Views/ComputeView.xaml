<UserControl x:Class="VoiceLockStudio.Views.ComputeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoiceLockStudio.Controls"
             xmlns:loc="clr-namespace:VoiceLockStudio.Services.Localization"
             xmlns:vm="clr-namespace:VoiceLockStudio.ViewModels">
    <StackPanel>

        <!-- Compute Guidance Card -->
        <Border Style="{StaticResource GalleryGuidanceCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="28"
                        Height="28"
                        CornerRadius="6"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,12,0">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE946;"
                               FontSize="14"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ComputeGuideTitle}"
                               Style="{StaticResource GallerySectionTitleTextStyle}" />
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ComputeGuideBody}"
                               FontSize="12.5"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Backend Option Cards -->
        <Border Style="{StaticResource GalleryCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE950;"
                                   FontSize="15"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ComputeCardTitle}"
                                   Style="{StaticResource GallerySectionTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding BackendStatusBanner}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CPU Single-Thread E-Core Lock -->
                    <RadioButton Grid.Column="0"
                                 GroupName="ComputeBackendGroup"
                                 Style="{StaticResource BackendOptionCardStyle}"
                                 IsChecked="{Binding IsCpuBackendSelected, Mode=TwoWay}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CpuBackendTitle}"
                                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                           FontSize="13.5"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="4"
                                        Padding="6,1"
                                        Margin="8,0,6,0"
                                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CpuBackendBadge}"
                                               FontSize="11"
                                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                </Border>
                                <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=CpuBackendHint}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CpuBackendSubtitle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <!-- CUDA GPU Acceleration -->
                    <RadioButton Grid.Column="2"
                                 GroupName="ComputeBackendGroup"
                                 Style="{StaticResource BackendOptionCardStyle}"
                                 IsChecked="{Binding IsCudaBackendSelected, Mode=TwoWay}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CudaBackendTitle}"
                                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=CudaBackendHint}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CudaBackendSubtitle}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <!-- CUDA Fallback Warning Bar -->
                <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,9"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasCudaFallbackNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE7BA;"
                                   FontSize="13"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CudaFallbackNotice}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- CPU Topology & Affinity Card -->
        <Border Style="{StaticResource GalleryCardStyle}">
            <StackPanel>
                <TextBlock Text="{Binding CpuTopologySummary}"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AutoAffinityTitle}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=AutoAffinityHint}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AutoAffinitySubtitle}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding AutoAffinityEnabled, Mode=TwoWay}" />
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,0,0,10" />

                <!-- Expandable Core Matrix -->
                <Expander IsExpanded="{Binding IsCoreMatrixExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=CustomCoreMatrixTitle}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=CustomCoreMatrixHint}" />
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding CoreMatrixItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CpuCoreItemViewModel}">
                                    <ToggleButton Style="{StaticResource CorePillToggleStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding DataContext.AutoAffinityEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolConverter}}"
                                                  ToolTip="{Binding TooltipText}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CoreTypeLabel}"
                                                       FontSize="10.5"
                                                       Opacity="0.85"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ManualCoreHintText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="{Binding AutoAffinityEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=ApplyCoreSelectionButton}"
                                    Command="{Binding ApplyCoreSelectionCommand}"
                                    IsEnabled="{Binding AutoAffinityEnabled, Converter={StaticResource InverseBoolConverter}}"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
