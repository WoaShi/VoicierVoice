<UserControl x:Class="VoiceLockStudio.Views.OtherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoiceLockStudio.Controls"
             xmlns:loc="clr-namespace:VoiceLockStudio.Services.Localization">
    <StackPanel>

        <!-- Section Header -->
        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=OtherSettingsTitle}"
                   Style="{StaticResource GallerySectionTitleTextStyle}"
                   Margin="2,0,0,12" />

        <!-- Theme Switcher Card -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE790;"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ThemeLabel}"
                               FontSize="13.5"
                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=ThemeHint}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="ThemePreferenceGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=ThemeOptionSystem}"
                                     IsChecked="{Binding SelectedThemePreference, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}" />
                        <RadioButton GroupName="ThemePreferenceGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=ThemeOptionLight}"
                                     IsChecked="{Binding SelectedThemePreference, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Light}" />
                        <RadioButton GroupName="ThemePreferenceGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=ThemeOptionDark}"
                                     IsChecked="{Binding SelectedThemePreference, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Dark}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Language Switcher Card -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE775;"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=LanguageLabel}"
                               FontSize="13.5"
                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=LanguageHint}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="LanguagePreferenceGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=LanguageOptionZhCn}"
                                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ZhCn}" />
                        <RadioButton GroupName="LanguagePreferenceGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=LanguageOptionEnUs}"
                                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EnUs}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Launch on Windows Startup Card -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE7E8;"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=LaunchOnStartupLabel}"
                               FontSize="13.5"
                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=LaunchOnStartupHint}" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          Style="{StaticResource FluentToggleSwitchStyle}"
                          IsChecked="{Binding LaunchOnStartupEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- System & Tray Behavior Card -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                               Text="&#xE7F4;"
                               FontSize="16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=MinimizeToTrayLabel}"
                               FontSize="13.5"
                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=MinimizeToTrayHint}" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          Style="{StaticResource FluentToggleSwitchStyle}"
                          IsChecked="{Binding MinimizeToTrayEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- About & Data Card -->
        <TextBlock Text="{Binding AboutCardTitle}"
                   Style="{StaticResource GallerySectionTitleTextStyle}"
                   Margin="2,0,0,12" />

        <Border Style="{StaticResource GalleryCardStyle}">
            <StackPanel>
                <!-- Brand Header with Logo (no Preview badge) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="pack://application:,,,/VoicierVoice;component/Assets/Icons/VoicierVoice.png"
                           Width="44"
                           Height="44"
                           Margin="0,0,14,0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AppTitle}"
                                   FontSize="16"
                                   FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AppSubtitle}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,14,0,14" />

                <!-- Core Engine & Open-Source Acknowledgements -->
                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutCreditsTitle}"
                           FontSize="12.5"
                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,10" />

                <!-- Highlighted VoxLock Core Engine Credit -->
                <Border Style="{StaticResource GallerySubCardStyle}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="VoxLock"
                                           FontSize="13.5"
                                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                           VerticalAlignment="Center" />
                                <Border CornerRadius="4"
                                        Padding="7,2"
                                        Margin="8,0,0,0"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutVoxLockBadge}"
                                               FontSize="11"
                                               FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutVoxLockDesc}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,2" />
                            <TextBlock Text="https://github.com/arbazsiddiqui/voxlock"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/arbazsiddiqui/voxlock"
                                Padding="11,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GitHub" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           Text="&#xE8A7;"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Open-Source Models & Libraries -->
                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutOpenSourceDesc}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,8" />

                <StackPanel>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Silero VAD (snakers4/silero-vad)"
                                       FontSize="12.5"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutSileroDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/snakers4/silero-vad"
                                ToolTip="https://github.com/snakers4/silero-vad"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="GTCRN (Xiaobin-Rong/gtcrn, k2-fsa/sherpa-onnx)"
                                       FontSize="12.5"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutGtcrnDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/Xiaobin-Rong/gtcrn"
                                ToolTip="https://github.com/Xiaobin-Rong/gtcrn"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Microsoft.ML.OnnxRuntime.Gpu (v1.17.1)"
                                       FontSize="12.5"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutOrtDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/microsoft/onnxruntime"
                                ToolTip="https://github.com/microsoft/onnxruntime"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="NAudio (v2.3.0)"
                                       FontSize="12.5"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutNAudioDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/naudio/NAudio"
                                ToolTip="https://github.com/naudio/NAudio"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="CommunityToolkit.Mvvm (v8.4.2)"
                                       FontSize="12.5"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AboutMvvmDesc}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding OpenExternalUrlCommand}"
                                CommandParameter="https://github.com/CommunityToolkit/dotnet"
                                ToolTip="https://github.com/CommunityToolkit/dotnet"
                                Padding="9,4"
                                VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}" Text="&#xE8A7;" FontSize="12" />
                        </Button>
                    </Grid>
                </StackPanel>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,14,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=AppDataPathLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding AppDataDirectoryPath}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding OpenAppDataFolderCommand}"
                            Content="{Binding OpenFolderButtonText}"
                            Padding="12,6"
                            VerticalAlignment="Center" />
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,14,0,14" />

                <Button Command="{Binding ExitApplicationCommand}"
                        Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=ExitApplicationButton}"
                        HorizontalAlignment="Right"
                        Padding="14,6" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
