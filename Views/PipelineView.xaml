<UserControl x:Class="VoiceLockStudio.Views.PipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoiceLockStudio.Controls"
             xmlns:loc="clr-namespace:VoiceLockStudio.Services.Localization"
             xmlns:vm="clr-namespace:VoiceLockStudio.ViewModels">
    <StackPanel>

        <!-- Hero Header Banner with Top-Transparent-to-Bottom-Opaque Mask & Vertical Golden-Ratio Acrylic Buttons -->
        <Grid Height="336" Margin="0,0,0,16">
            <!-- Rounded Hero Illustration -->
            <Border CornerRadius="8" IsHitTestVisible="False">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/VoicierVoice;component/Assets/Images/HomeHero.jpg"
                                Stretch="UniformToFill"
                                AlignmentX="Center"
                                AlignmentY="Center" />
                </Border.Background>
            </Border>

            <!-- Top-Transparent to Bottom-Opaque Gradient Mask (adapts to Light/Dark theme automatically) -->
            <Border CornerRadius="8"
                    IsHitTestVisible="False"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0.00" />
                        <GradientStop Color="#1AFFFFFF" Offset="0.24" />
                        <GradientStop Color="#9EFFFFFF" Offset="0.56" />
                        <GradientStop Color="#EBFFFFFF" Offset="0.82" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.98" />
                    </LinearGradientBrush>
                </Border.OpacityMask>
            </Border>

            <!-- Three Vertical Golden-Ratio (144 x 233, phi=1.618) Acrylic Buttons Placed in the Mask Region -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="16,0,16,12">

                <!-- Step 1 Acrylic Button -> Audio Routing Card -->
                <Button Width="144"
                        Height="233"
                        Margin="0,0,18,0"
                        Style="{StaticResource AcrylicGuidanceButtonStyle}"
                        Command="{Binding NavigateGuidanceCommand}"
                        CommandParameter="{x:Static vm:GuidanceTarget.AudioRouting}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,14"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE7F5;"
                                       FontSize="19"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep1Title}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,7" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep1Desc}"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE8A7;"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Button>

                <!-- Step 2 Acrylic Button -> Voiceprint Tab & Capture Card -->
                <Button Width="144"
                        Height="233"
                        Margin="0,0,18,0"
                        Style="{StaticResource AcrylicGuidanceButtonStyle}"
                        Command="{Binding NavigateGuidanceCommand}"
                        CommandParameter="{x:Static vm:GuidanceTarget.VoiceprintCapture}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,14"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE720;"
                                       FontSize="19"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep2Title}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,7" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep2Desc}"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE8A7;"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Button>

                <!-- Step 3 Acrylic Button -> Global Master Isolation Switch -->
                <Button Width="144"
                        Height="233"
                        Style="{StaticResource AcrylicGuidanceButtonStyle}"
                        Command="{Binding NavigateGuidanceCommand}"
                        CommandParameter="{x:Static vm:GuidanceTarget.MasterSwitch}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,14"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE7E8;"
                                       FontSize="19"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep3Title}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,7" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=QuickStartStep3Desc}"
                                       FontSize="11.5"
                                       LineHeight="17"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE8A7;"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Merged Telemetry & Signal Level Card (Latency + Inference + Active Core + IN/OUT) -->
        <Border Style="{StaticResource GalleryCardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=TotalLatency}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TelemetryLatencyText}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2" />

                    <StackPanel Grid.Column="2" Margin="18,0,16,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=FrameInference}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TelemetryInferenceText}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0" />
                    </StackPanel>

                    <Border Grid.Column="3"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,2" />

                    <StackPanel Grid.Column="4" Margin="18,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=ActiveCore}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding TelemetryCoreText}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="14.5"
                                   FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,14,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=InputLevelLabel}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Style="{StaticResource RoundedLevelProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding InputLevelPercent, Mode=OneWay}"
                                     Height="6"
                                     VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=OutputLevelLabel}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1"
                                     Style="{StaticResource RoundedLevelProgressBarStyle}"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding OutputLevelPercent, Mode=OneWay}"
                                     Height="6"
                                     VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Audio Routing Card with Animated Guidance Border -->
        <Grid x:Name="RoutingCardHost" Margin="0,0,0,16">
            <Border Style="{StaticResource GalleryCardStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                   Text="&#xE9E9;"
                                   FontSize="15"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=RoutingCardTitle}"
                                   Style="{StaticResource GallerySectionTitleTextStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding RefreshDevicesCommand}"
                            Padding="10,5"
                            ToolTip="{Binding Source={x:Static loc:AppStrings.Current}, Path=RefreshDevicesTooltip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE72C;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=RefreshDevicesButton}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=InputDeviceLabel}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=InputDeviceHint}" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding CaptureDevices}"
                                  SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource CaptureDeviceItemTemplate}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=OutputDeviceLabel}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=OutputDeviceHint}" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding RenderDevices}"
                                  SelectedItem="{Binding SelectedRenderDevice, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource RenderDeviceItemTemplate}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Margin="0,2,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=MonitorLoopbackLabel}"
                                   FontSize="13"
                                   FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=MonitorLoopbackHint}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding MonitorLoopbackEnabled, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="RoutingGuideOverlay"
                CornerRadius="8"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>

        <!-- Cascade DSP Stack (WPFGallery Stacked Card Rows) -->
        <!-- Stage 1: Silero-VAD -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VadStageTitle}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VadStageHint}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding VadLiveProbPrefix}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{Binding VadLiveProbText}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11.5"
                                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VadStageSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding VadEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,12,0,0" IsEnabled="{Binding VadEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VadThresholdLabel}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VadThresholdHint}" />
                    </StackPanel>

                    <Slider Grid.Column="1"
                            Minimum="0.05"
                            Maximum="0.95"
                            TickFrequency="0.05"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            Value="{Binding VadThreshold, Mode=TwoWay}"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding VadThresholdText}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="12.5"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Stage 2: GTCRN -->
        <Border Style="{StaticResource GallerySettingsRowStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=GtcrnStageTitle}"
                                   FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                   FontSize="13.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=GtcrnStageHint}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=GtcrnStageSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <CheckBox Grid.Column="1"
                          Style="{StaticResource FluentToggleSwitchStyle}"
                          IsChecked="{Binding GtcrnEnabled, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Stage 3: VoxLock -->
        <Border Style="{StaticResource GallerySettingsRowStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockStageTitle}"
                                       FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                       FontSize="13.5"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockStageHint}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockStageSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockVariantHint}"
                                                Margin="0,0,6,0" />
                        <ComboBox Width="195"
                                  ItemsSource="{Binding VoxLockVariants}"
                                  SelectedItem="{Binding SelectedVoxLockVariant, Mode=TwoWay}"
                                  IsEnabled="{Binding VoxLockEnabled}"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource VoxLockVariantLabelConverter}">
                                                <Binding />
                                                <Binding Source="{x:Static loc:AppStrings.Current}" Path="Language" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding VoxLockEnabled, Mode=TwoWay}" />
                </Grid>

                <Grid Margin="0,12,0,0" IsEnabled="{Binding VoxLockEnabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockLowLatencyLabel}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />
                        <controls:InfoHintBadge HintText="{Binding Source={x:Static loc:AppStrings.Current}, Path=VoxLockLowLatencyHint}" />
                    </StackPanel>

                    <CheckBox Grid.Column="1"
                              Style="{StaticResource FluentToggleSwitchStyle}"
                              IsChecked="{Binding VoxLockLowLatencyMode, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
