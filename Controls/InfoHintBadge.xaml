<UserControl x:Class="VoiceLockStudio.Controls.InfoHintBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             IsTabStop="False"
             VerticalAlignment="Center">
    <Border x:Name="BadgeSurface"
            Width="18"
            Height="18"
            CornerRadius="9"
            Cursor="Help"
            ToolTipService.InitialShowDelay="120"
            ToolTipService.ShowDuration="15000"
            ToolTipService.Placement="Top">
        <Border.Resources>
            <ToolTip x:Key="HintToolTipResource"
                     MaxWidth="310"
                     Padding="10,8">
                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           LineHeight="18" />
            </ToolTip>
        </Border.Resources>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                   Text="&#xE946;"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=BadgeSurface}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Border>
</UserControl>
