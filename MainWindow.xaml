<Window x:Class="VoiceLockStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VoiceLockStudio.Converters"
        xmlns:vm="clr-namespace:VoiceLockStudio.ViewModels"
        xmlns:audio="clr-namespace:VoiceLockStudio.Services.Audio"
        mc:Ignorable="d"
        Title="VoiceLock Studio"
        Width="780"
        MinWidth="680"
        Height="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter" />
        <converters:VoxLockVariantLabelConverter x:Key="VoxLockVariantLabelConverter" />

        <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

        <!-- Fluent 2 Card Container -->
        <Style x:Key="FluentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Fluent 2 Subtle Nested Surface -->
        <Style x:Key="FluentSubCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Fluent 2 ToggleSwitch (templated CheckBox using PresentationFramework.Fluent theme brushes) -->
        <Style x:Key="FluentToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForeground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="SwitchTrack"
                                    Width="40"
                                    Height="20"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Background="{DynamicResource ToggleSwitchFillOff}"
                                    BorderBrush="{DynamicResource ToggleSwitchStrokeOff}"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="12"
                                             Height="12"
                                             Fill="{DynamicResource ToggleSwitchKnobFillOff}"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="3,0,0,0" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="ContentHost"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchKnob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
                                <Setter TargetName="SwitchKnob" Property="Width" Value="14" />
                                <Setter TargetName="SwitchKnob" Property="Height" Value="14" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOver}" />
                                <Setter TargetName="SwitchKnob" Property="Width" Value="14" />
                                <Setter TargetName="SwitchKnob" Property="Height" Value="14" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                                <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsEnabled" Value="False" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                                <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CPU Core Matrix Pill Toggle -->
        <Style x:Key="CorePillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Capture Device ItemTemplate -->
        <DataTemplate x:Key="CaptureDeviceItemTemplate" DataType="{x:Type audio:AudioDeviceInfo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FriendlyName}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,1"
                        CornerRadius="4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="默认"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Render Device ItemTemplate (highlights Virtual Cable endpoints) -->
        <DataTemplate x:Key="RenderDeviceItemTemplate" DataType="{x:Type audio:AudioDeviceInfo}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding FriendlyName}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="6,1"
                        CornerRadius="4"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        Visibility="{Binding IsVirtualAudioDevice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="虚拟声卡"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                </Border>
                <Border Grid.Column="2"
                        Margin="6,0,0,0"
                        Padding="6,1"
                        CornerRadius="4"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="默认"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="20,16,20,20">
        <StackPanel MaxWidth="760">

            <!-- ============================================================ -->
            <!-- CARD 1: Status & Telemetry Header                            -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title + Status Pill + Backend Subtitle -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           Text="&#xE72E;"
                                           FontSize="18"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="VoiceLock Studio"
                                           Style="{DynamicResource SubtitleTextBlockStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <!-- Restrained Semantic Status Pill -->
                                <Border CornerRadius="12"
                                        Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Background}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Foreground}" />
                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Foreground}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding BackendStatusBanner}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Right: Global Pipeline ToggleSwitch -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">
                            <TextBlock Text="实时声纹提取"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <CheckBox Style="{StaticResource FluentToggleSwitchStyle}"
                                      IsChecked="{Binding IsPipelineRunning, Mode=TwoWay}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                      ToolTip="开启或关闭实时级联降噪与声纹提取管线" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,14,0,12" />

                    <!-- Bottom Row: Monospace Telemetry Strip + Input/Output Level Bars -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,22,0">
                            <TextBlock Text="算法延迟"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TelemetryLatencyText}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,22,0">
                            <TextBlock Text="单帧推理耗时"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TelemetryInferenceText}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="活跃核心"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding TelemetryCoreText}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Subtle Input / Output Level Indicators -->
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="IN"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding InputLevelPercent, Mode=OneWay}"
                                             Height="4"
                                             VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="OUT"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding OutputLevelPercent, Mode=OneWay}"
                                             Height="4"
                                             VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- CARD 2: Voiceprint Profile Card                              -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE720;"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="个人声纹档案 (预录 5 秒样本)"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Local WAV + Model Cache Status Indicator -->
                        <Border Grid.Column="1"
                                CornerRadius="10"
                                Padding="9,3"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVoiceprintCache}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding VoiceprintStatusText}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVoiceprintCache}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Prompt text to read aloud -->
                    <Border Style="{StaticResource FluentSubCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="请保持正常说话音量，清晰朗读下方引导文本（约 5 秒）："
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PromptReadText}"
                                       FontSize="13.5"
                                       LineHeight="20"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{DynamicResource AccentButtonStyle}"
                                Command="{Binding RecordVoiceprintCommand}"
                                Margin="0,0,8,0"
                                Padding="14,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE720;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="录制我的声纹 (5秒)" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="停止录制" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Command="{Binding PlaySampleCommand}"
                                Margin="0,0,8,0"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE768;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayingSample}" Value="True">
                                                    <Setter Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="试听原始样本" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlayingSample}" Value="True">
                                                    <Setter Property="Text" Value="停止试听" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding RebuildCacheCommand}"
                                Content="重建声纹缓存"
                                Padding="12,6"
                                ToolTip="从本地 user_raw_voice.wav 重新提取当前模型精度对应的声纹特征缓存" />

                        <TextBlock Grid.Column="3"
                                   Text="{Binding RecordingStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <!-- Minimal Recording Progress + Live Mic Level + Local File/Cache Detail -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="录制进度"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,3" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding RecordingProgress, Mode=OneWay}"
                                         Height="4" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="实时麦克风电平"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,3" />
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding RecordingLevel, Mode=OneWay}"
                                         Height="4" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding VoiceprintDetailText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- CARD 3: Audio Routing & Cascade DSP Pipeline Card            -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE9E9;"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="音频路由与级联降噪管线"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding RefreshDevicesCommand}"
                                Padding="8,4"
                                ToolTip="刷新 WASAPI 音频输入/输出设备列表">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           Text="&#xE72C;"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="刷新设备" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Capture & Render Device Selectors -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="输入麦克风 (WASAPI Capture)"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding CaptureDevices}"
                                      SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource CaptureDeviceItemTemplate}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="输出设备 / 虚拟声卡 (WASAPI Render)"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding RenderDevices}"
                                      SelectedItem="{Binding SelectedRenderDevice, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource RenderDeviceItemTemplate}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="实时监听自己声音（调试回环；输出至虚拟声卡 CABLE Input 时建议关闭以免回声）"
                              IsChecked="{Binding MonitorLoopbackEnabled, Mode=TwoWay}"
                              FontSize="12.5"
                              Margin="0,2,0,4" />

                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,10,0,12" />

                    <!-- 3 Independent Cascade DSP Stage Toggles -->
                    <!-- Stage 1: Silero-VAD -->
                    <Border Style="{StaticResource FluentSubCardStyle}" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="[前置休眠] Silero-VAD"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding VadLiveProbText, StringFormat='  ·  实时概率 {0}'}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="无人说话时自动进入静音休眠，降低下游模型算力占用"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource FluentToggleSwitchStyle}"
                                          IsChecked="{Binding VadEnabled, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,10,0,0" IsEnabled="{Binding VadEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="检测灵敏度阈值"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Slider Grid.Column="1"
                                        Minimum="0.05"
                                        Maximum="0.95"
                                        TickFrequency="0.05"
                                        SmallChange="0.05"
                                        LargeChange="0.1"
                                        Value="{Binding VadThreshold, Mode=TwoWay}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding VadThresholdText}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Stage 2: GTCRN -->
                    <Border Style="{StaticResource FluentSubCardStyle}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="[前置降噪] GTCRN"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock Text="超轻量语音增强模型（&lt; 1.8 ms），优先消除键盘声、风扇声等稳态底噪"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      IsChecked="{Binding GtcrnEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Stage 3: VoxLock -->
                    <Border Style="{StaticResource FluentSubCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="[核心提取] VoxLock"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock Text="依据个人声纹锁相提取目标人声，抑制旁人交谈与突发人声干扰"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding VoxLockVariants}"
                                      SelectedItem="{Binding SelectedVoxLockVariant, Mode=TwoWay}"
                                      IsEnabled="{Binding VoxLockEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource VoxLockVariantLabelConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <CheckBox Grid.Column="2"
                                      Style="{StaticResource FluentToggleSwitchStyle}"
                                      IsChecked="{Binding VoxLockEnabled, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- CARD 4: Compute & Core Affinity Card                         -->
            <!-- ============================================================ -->
            <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE950;"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="推理算力后端与 CPU 物理核绑定"
                                       Style="{DynamicResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CpuTopologySummary}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- CPU vs CUDA Selector -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource FluentSubCardStyle}">
                            <RadioButton GroupName="ComputeBackendGroup"
                                         IsChecked="{Binding IsCpuBackendSelected, Mode=TwoWay}"
                                         VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="CPU 单线程锁核 (推荐)"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Text="低延迟、零拷贝，稳定控制实时语音抖动"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource FluentSubCardStyle}">
                            <RadioButton GroupName="ComputeBackendGroup"
                                         IsChecked="{Binding IsCudaBackendSelected, Mode=TwoWay}"
                                         VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="CUDA GPU 加速"
                                               FontWeight="SemiBold"
                                               FontSize="13" />
                                    <TextBlock Text="使用 NVIDIA GPU 运行 VoxLock ONNX 推理"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>

                    <!-- CUDA Fallback Notice Banner -->
                    <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10"
                            Visibility="{Binding HasCudaFallbackNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                       Text="&#xE7BA;"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CudaFallbackNotice}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="0,4,0,12" />

                    <!-- Auto Affinity Switch -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="自动绑定至能效核/尾核并锁定单线程"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                            <TextBlock Text="将音频处理与推理线程固定到指定核心，避免游戏或高负载场景抢占主核"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource FluentToggleSwitchStyle}"
                                  IsChecked="{Binding AutoAffinityEnabled, Mode=TwoWay}" />
                    </Grid>

                    <!-- Expandable CPU Core Affinity Matrix -->
                    <Expander Header="自定义 CPU 核心亲和性矩阵"
                              IsExpanded="{Binding IsCoreMatrixExpanded, Mode=TwoWay}">
                        <StackPanel Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding CoreMatrixItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CpuCoreItemViewModel}">
                                        <ToggleButton Style="{StaticResource CorePillToggleStyle}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding DataContext.AutoAffinityEnabled, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                                      ToolTip="{Binding TooltipText}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Label}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CoreTypeLabel}"
                                                           FontSize="10"
                                                           Opacity="0.82"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,6,0,0">
                                <TextBlock Text="关闭上方“自动绑定”开关后可手动勾选物理核"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Visibility="{Binding AutoAffinityEnabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="应用核心选择"
                                        Command="{Binding ApplyCoreSelectionCommand}"
                                        IsEnabled="{Binding AutoAffinityEnabled, Converter={StaticResource InverseBoolConverter}}"
                                        Padding="12,5" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- Footer: Tray Behavior & Exit                                 -->
            <!-- ============================================================ -->
            <Grid Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          Content="关闭窗口时最小化到系统托盘后台运行"
                          IsChecked="{Binding MinimizeToTrayEnabled, Mode=TwoWay}"
                          FontSize="12"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding ExitApplicationCommand}"
                        Content="退出程序"
                        Padding="12,5"
                        FontSize="12" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
