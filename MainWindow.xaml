<Window x:Class="VoiceLockStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:VoiceLockStudio.Services.Localization"
        xmlns:controls="clr-namespace:VoiceLockStudio.Controls"
        xmlns:views="clr-namespace:VoiceLockStudio.Views"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:AppStrings.Current}, Path=WindowTitle}"
        Icon="pack://application:,,,/VoicierVoice;component/Assets/Icons/VoicierVoice.ico"
        Width="1040"
        Height="700"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayoutGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- Left Navigation Rail (Immersive Borderless Fluent 2 Shell)   -->
        <!-- ============================================================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top-Left Window Bar with Back Button + Color App Logo -->
                <Grid Grid.Row="0" Background="Transparent">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="6,4,0,0">
                        <Button Style="{StaticResource TitleBarBackButtonStyle}"
                                Command="{Binding NavigateBackCommand}"
                                ToolTip="{Binding Source={x:Static loc:AppStrings.Current}, Path=NavigateBackTooltip}"
                                VerticalAlignment="Center" />
                        <Image Source="pack://application:,,,/VoicierVoice;component/Assets/Icons/VoicierVoice.png"
                               Width="20"
                               Height="20"
                               Margin="6,0,0,0"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    </StackPanel>
                </Grid>

                <!-- Primary Navigation Tabs -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <RadioButton GroupName="MainNavigationGroup"
                                 Style="{StaticResource NavigationRailItemStyle}"
                                 Tag="&#xE9E9;"
                                 Checked="OnNavItemChecked"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pipeline}"
                                 Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=NavPipelineTitle}" />

                    <RadioButton GroupName="MainNavigationGroup"
                                 Style="{StaticResource NavigationRailItemStyle}"
                                 Tag="&#xE720;"
                                 Checked="OnNavItemChecked"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Voiceprint}"
                                 Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=NavVoiceprintTitle}" />

                    <RadioButton GroupName="MainNavigationGroup"
                                 Style="{StaticResource NavigationRailItemStyle}"
                                 Tag="&#xE950;"
                                 Checked="OnNavItemChecked"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Compute}"
                                 Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=NavComputeTitle}" />
                </StackPanel>

                <!-- Pinned Bottom Settings Item -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Border Height="1"
                            Margin="14,6,14,8"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <RadioButton GroupName="MainNavigationGroup"
                                 Style="{StaticResource NavigationRailItemStyle}"
                                 Tag="&#xE713;"
                                 Checked="OnNavItemChecked"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=OtherSettings}"
                                 Content="{Binding Source={x:Static loc:AppStrings.Current}, Path=NavOtherTitle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Right Content Area                                           -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Draggable Top Caption Spacer (Native DWM Caption Buttons at top-right) -->
            <Border Grid.Row="0" Background="Transparent" />

            <!-- Global Top Header Bar -->
            <Border Grid.Row="1"
                    Padding="28,8,28,14"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Dynamic Kaomoji Status Display: ( • vv • ) / d( • vv • )b / d( ^ ∀ ^ )b -->
                    <controls:KaomojiStatusView x:Name="HeaderKaomoji"
                                                Grid.Column="0"
                                                IsPipelineActive="{Binding IsPipelineRunning}"
                                                StatusKind="{Binding StatusKind}"
                                                ToolTip="{Binding StatusBadgeText}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center" />

                    <!-- Compact Global Master Isolation Switch with Guidance Pulse Border -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Border Padding="10,6" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source={x:Static loc:AppStrings.Current}, Path=MasterSwitchTitle}"
                                           FontSize="13"
                                           FontWeight="{Binding Source={x:Static loc:AppStrings.Current}, Path=StrongFontWeight}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <CheckBox Style="{StaticResource FluentToggleSwitchStyle}"
                                          IsChecked="{Binding IsPipelineRunning, Mode=TwoWay}"
                                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                          ToolTip="{Binding Source={x:Static loc:AppStrings.Current}, Path=MasterSwitchTooltip}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MasterSwitchGuideOverlay"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Scrollable Spacious Page Host -->
            <ScrollViewer x:Name="PageScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,20">
                <Grid MaxWidth="860">
                    <views:PipelineView>
                        <views:PipelineView.Style>
                            <Style TargetType="views:PipelineView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Pipeline">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PipelineView.Style>
                    </views:PipelineView>

                    <views:VoiceprintView>
                        <views:VoiceprintView.Style>
                            <Style TargetType="views:VoiceprintView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Voiceprint">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:VoiceprintView.Style>
                    </views:VoiceprintView>

                    <views:ComputeView>
                        <views:ComputeView.Style>
                            <Style TargetType="views:ComputeView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="Compute">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ComputeView.Style>
                    </views:ComputeView>

                    <views:OtherSettingsView>
                        <views:OtherSettingsView.Style>
                            <Style TargetType="views:OtherSettingsView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="OtherSettings">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:OtherSettingsView.Style>
                    </views:OtherSettingsView>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- Startup Splash Overlay: "voicier voice" -> "( • vv • )"     -->
        <!-- ============================================================ -->
        <Grid x:Name="SplashOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Visibility="Visible">
            <Border x:Name="SplashWhiteBackdrop"
                    Background="#FFFFFF" />

            <StackPanel x:Name="SplashWordmarkPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="SplashV1"
                           Text="v"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="32"
                           Foreground="#1A1A1A"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashV1Scale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="SplashV1Translate" X="0" Y="0" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SplashRest1"
                           Text="oicier "
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="32"
                           Foreground="#1A1A1A" />
                <TextBlock x:Name="SplashV2"
                           Text="v"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="32"
                           Foreground="#1A1A1A"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashV2Scale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="SplashV2Translate" X="0" Y="0" />
                        </TransformGroup>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock x:Name="SplashRest2"
                           Text="oice"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="32"
                           Foreground="#1A1A1A" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
